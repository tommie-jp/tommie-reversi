{
  // core/ must stay pure TypeScript: no DOM, no Node, no Babylon.
  // This config type-checks core alone without DOM lib or @types/node,
  // so any accidental dependency fails `npm run check`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src/core"]
}
