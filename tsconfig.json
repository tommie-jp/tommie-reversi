{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  // Browser code. Node-only code (the CLI, the Node serial transport) and the tests
  // are checked by tsconfig.node.json, so Node and DOM types never mix.
  "include": ["src"],
  "exclude": ["src/cli", "src/transport/node-serial.ts"]
}
