{
  "name": "tommie-reversi",
  "private": true,
  "version": "0.0.1",
  "description": "Reversi app for playing against a homebrew CPU over UART (RUP)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tommie-jp/tommie-reversi.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.core.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:md": "npx --yes markdownlint-cli '*.md' 'docs/*.md'",
    "cli": "tsx src/cli/main.ts",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  }
}
