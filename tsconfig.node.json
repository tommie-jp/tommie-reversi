{
  // Node code: the CLI, the Node serial transport and the tests. No DOM types.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src/core", "src/cli", "src/transport", "src/view/terminal", "test", "vitest.config.ts", "vite.config.ts"],
  // Browser code and its tests are checked by tsconfig.web-test.json.
  "exclude": ["test/app", "test/view/html", "test/transport-web", "src/transport/web-serial.ts"]
}
